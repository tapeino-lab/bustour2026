rules_version = '2';

// Access rules for the Firestore database.
// Paste this whole file into Firebase console → Firestore Database → Rules, then press Publish.
//
//   config/join      { code: "<join code>" }   set in the console only; nobody can read it
//   admins/{uid}     {}                        set in the console only; who can upload faces
//   members/{uid}    { code, joinedAt }        created by a device that entered the right code
//   faces/{pieceId}  { image, visible, enhance?, updatedAt }  photo (JPEG, or PNG for cut-outs); members see it
//                    only while visible. enhance: how strongly it is evened out ('strong', 'soft', 'none')
//   media/bgm        { audio, updatedAt }      background music (audio data URL), members only
//   scores/{uid}     { name, count, countHeight?, towerCount?, countAt?,
//                      height, heightCount?, towerHeight?, heightAt?, updatedAt }
//                    a player's two records for the rankings, members only. Each record is kept as
//                    the set from the game that made it: the count record (count + that game's
//                    height + its tower + when) and the height record (height + that game's count
//                    + its tower + when). Older entries lack the partner numbers. An admin can
//                    reset one ranking: that record becomes 0 (an entry with neither is deleted).
//   plays/{uid}      { count, lastAt, name? }  play history per device (games played, last game);
//                    written by the device, read by admins
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isMember() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Ranking entry: a 1–3 letter hiragana name (ー allowed), sane numbers, optional tower snapshots.
    function validTower(d, key) {
      return !(key in d) || (d[key] is string && d[key].size() < 12000 && d[key].matches('^v1[|].*'));
    }
    function validScore(d) {
      return d.keys().hasAll(['name', 'count', 'height', 'updatedAt'])
        && d.keys().hasOnly(['name', 'count', 'height', 'updatedAt', 'towerCount', 'towerHeight', 'countAt', 'heightAt',
                             'countHeight', 'heightCount'])
        && (!('countHeight' in d) || (d.countHeight is number && d.countHeight >= 0 && d.countHeight <= 1000))
        && (!('heightCount' in d) || (d.heightCount is int && d.heightCount >= 0 && d.heightCount <= 1000))
        && validTower(d, 'towerCount')
        && validTower(d, 'towerHeight')
        && d.name is string
        && d.name.matches('^[ぁ-ゖー]{1,3}$')
        && d.count is int && d.count >= 0 && d.count <= 1000
        && d.height is number && d.height >= 0 && d.height <= 1000
        && d.updatedAt == request.time;
    }
    // When a record was set (breaks ties): stamped now when the record goes up, otherwise unchanged.
    function newRecordTime(key) {
      return !(key in request.resource.data) || request.resource.data[key] == request.time;
    }
    // A record (valueKey, with partnerKey from the same game and its time timeKey) may only get
    // better: a higher value, or the same value with a higher partner. Then its time is now;
    // otherwise the partner and the time stay as they were.
    // Admin reset of one record: either all of it unchanged, or the value 0 and the rest gone.
    function keptOrReset(valueKey, partnerKey, timeKey, towerKey) {
      let d = request.resource.data;
      let old = resource.data;
      return (d[valueKey] == old[valueKey]
          && d.get(partnerKey, null) == old.get(partnerKey, null)
          && d.get(timeKey, null) == old.get(timeKey, null)
          && d.get(towerKey, null) == old.get(towerKey, null))
        || (d[valueKey] == 0 && !d.keys().hasAny([partnerKey, timeKey, towerKey]));
    }
    function validPlay(d) {
      return d.keys().hasAll(['count', 'lastAt'])
        && d.keys().hasOnly(['count', 'lastAt', 'name'])
        && d.count is int
        && d.lastAt == request.time
        && (!('name' in d) || (d.name is string && d.name.matches('^[ぁ-ゖー]{1,3}$')));
    }
    function recordUpdate(valueKey, partnerKey, timeKey) {
      let d = request.resource.data;
      let old = resource.data;
      let newPartner = d.get(partnerKey, -1);
      let oldPartner = old.get(partnerKey, -1);
      let better = d[valueKey] > old[valueKey] || (d[valueKey] == old[valueKey] && newPartner > oldPartner);
      return d[valueKey] >= old[valueKey]
        && (better
          ? d.get(timeKey, null) == request.time
          : newPartner == oldPartner && d.get(timeKey, null) == old.get(timeKey, null));
    }

    // The join code itself is never readable by any client.
    match /config/{doc} {
      allow read, write: if false;
    }

    // A device may only check whether it is an admin.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // A device becomes a member by writing its own doc with the correct join code.
    // Members can be removed (and codes changed) only in the console.
    match /members/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'joinedAt'])
        && request.resource.data.code is string
        // The console may store the code as text or as a number: compare as text.
        && request.resource.data.code == string(get(/databases/$(database)/documents/config/join).data.code)
        && request.resource.data.joinedAt == request.time;
      allow list, update, delete: if false;
    }

    // Rankings: one doc per device (its uid). Records may only get better; the name may change.
    match /scores/{uid} {
      allow read: if isMember() || isAdmin();
      allow create: if isMember() && request.auth.uid == uid && validScore(request.resource.data)
        && newRecordTime('countAt') && newRecordTime('heightAt');
      allow update: if (isMember() && request.auth.uid == uid && validScore(request.resource.data)
          && recordUpdate('count', 'countHeight', 'countAt')
          && recordUpdate('height', 'heightCount', 'heightAt'))
        // An admin resets the count or the height ranking: that record goes to 0 (with its
        // partner, time and tower removed); everything else stays.
        || (isAdmin() && validScore(request.resource.data)
          && request.resource.data.name == resource.data.name
          && keptOrReset('count', 'countHeight', 'countAt', 'towerCount')
          && keptOrReset('height', 'heightCount', 'heightAt', 'towerHeight'));
      // Only admins may delete (one entry, or an entry left with no record after a reset).
      allow delete: if isAdmin();
    }

    // Play history: one doc per device, counting its finished games. Written by the device
    // itself (one more game each time), read by admins only.
    match /plays/{uid} {
      allow read, delete: if isAdmin();
      allow create: if isMember() && request.auth.uid == uid && validPlay(request.resource.data)
        && request.resource.data.count == 1;
      allow update: if isMember() && request.auth.uid == uid && validPlay(request.resource.data)
        && request.resource.data.count == resource.data.count + 1;
    }

    // Background music: readable by members (and admins), writable by admins only.
    match /media/{id} {
      allow read: if isMember() || isAdmin();
      allow create, update: if isAdmin()
        && id == 'bgm'
        && request.resource.data.keys().hasOnly(['audio', 'updatedAt'])
        && request.resource.data.audio is string
        && request.resource.data.audio.size() < 950000
        && request.resource.data.audio.matches('^data:audio/(mpeg|mp3|mp4|x-m4a|aac|ogg|webm);base64,.*')
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // Face photos: readable by members (and admins), writable by admins only.
    // Registering and showing are separate: members can read a photo only while `visible` is on.
    match /faces/{pieceId} {
      allow read: if isAdmin() || (isMember() && resource.data.visible == true);
      allow create, update: if isAdmin()
        && pieceId.matches('^[a-z]{2,20}$')
        && request.resource.data.keys().hasOnly(['image', 'visible', 'enhance', 'updatedAt'])
        && (!('visible' in request.resource.data) || request.resource.data.visible is bool)
        && (!('enhance' in request.resource.data) || request.resource.data.enhance in ['strong', 'soft', 'none'])
        && request.resource.data.image is string
        && request.resource.data.image.size() < 200000
        && request.resource.data.image.matches('^data:image/(jpeg|png);base64,[A-Za-z0-9+/=]+$')
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }
  }
}
