rules_version = '2';

// Access rules for the Firestore database.
// Paste this whole file into Firebase console → Firestore Database → Rules, then press Publish.
//
//   config/join      { code: "<join code>" }   set in the console only; nobody can read it
//   admins/{uid}     {}                        set in the console only; who can upload faces
//   members/{uid}    { code, joinedAt }        created by a device that entered the right code
//   faces/{pieceId}  { image, updatedAt }      face photo (JPEG data URL), members only
//   scores/{uid}     { name, count, height, updatedAt, towerCount?, towerHeight? }
//                    personal bests for the rankings (+ tower snapshots), members only
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isMember() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Ranking entry: a 1–3 letter hiragana name (ー allowed), sane numbers, optional tower snapshots.
    function validTower(d, key) {
      return !(key in d) || (d[key] is string && d[key].size() < 12000 && d[key].matches('^v1[|].*'));
    }
    function validScore(d) {
      return d.keys().hasAll(['name', 'count', 'height', 'updatedAt'])
        && d.keys().hasOnly(['name', 'count', 'height', 'updatedAt', 'towerCount', 'towerHeight'])
        && validTower(d, 'towerCount')
        && validTower(d, 'towerHeight')
        && d.name is string
        && d.name.matches('^[ぁ-ゖー]{1,3}$')
        && d.count is int && d.count >= 0 && d.count <= 1000
        && d.height is number && d.height >= 0 && d.height <= 1000
        && d.updatedAt == request.time;
    }

    // The join code itself is never readable by any client.
    match /config/{doc} {
      allow read, write: if false;
    }

    // A device may only check whether it is an admin.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // A device becomes a member by writing its own doc with the correct join code.
    // Members can be removed (and codes changed) only in the console.
    match /members/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'joinedAt'])
        && request.resource.data.code is string
        // The console may store the code as text or as a number: compare as text.
        && request.resource.data.code == string(get(/databases/$(database)/documents/config/join).data.code)
        && request.resource.data.joinedAt == request.time;
      allow list, update, delete: if false;
    }

    // Rankings: one doc per device (its uid). Bests may only go up; the name may change.
    match /scores/{uid} {
      allow read: if isMember() || isAdmin();
      allow create: if isMember() && request.auth.uid == uid && validScore(request.resource.data);
      allow update: if isMember() && request.auth.uid == uid && validScore(request.resource.data)
        && request.resource.data.count >= resource.data.count
        && request.resource.data.height >= resource.data.height;
      allow delete: if false;
    }

    // Face photos: readable by members (and admins), writable by admins only.
    match /faces/{pieceId} {
      allow read: if isMember() || isAdmin();
      allow create, update: if isAdmin()
        && pieceId.matches('^[a-z]{2,20}$')
        && request.resource.data.keys().hasOnly(['image', 'updatedAt'])
        && request.resource.data.image is string
        && request.resource.data.image.size() < 200000
        && request.resource.data.image.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }
  }
}
