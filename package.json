    "typescript": "5.9",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "planck": "^1.4.2"
  }
}
